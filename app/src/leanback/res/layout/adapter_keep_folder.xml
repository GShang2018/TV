<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/selector_item_round"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp"
    android:clipChildren="false">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:clipChildren="false"
        android:padding="22dp">

        <ImageView
            android:id="@+id/cover3"
            android:layout_width="87dp"
            android:layout_height="116dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="60dp"
            android:background="@drawable/shape_keep_cover"
            android:clipToOutline="true"
            android:contentDescription="@string/keep_folder"
            android:elevation="12dp"
            android:translationZ="3dp"
            android:outlineProvider="background"
            android:outlineSpotShadowColor="#CC000000"
            android:outlineAmbientShadowColor="#99000000"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_img_loading" />

        <ImageView
            android:id="@+id/cover2"
            android:layout_width="98dp"
            android:layout_height="130dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="30dp"
            android:background="@drawable/shape_keep_cover"
            android:clipToOutline="true"
            android:contentDescription="@string/keep_folder"
            android:elevation="16dp"
            android:translationZ="5dp"
            android:outlineProvider="background"
            android:outlineSpotShadowColor="#DD000000"
            android:outlineAmbientShadowColor="#AA000000"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_img_loading" />

        <ImageView
            android:id="@+id/cover1"
            android:layout_width="108dp"
            android:layout_height="144dp"
            android:layout_gravity="bottom"
            android:background="@drawable/shape_keep_cover"
            android:clipToOutline="true"
            android:contentDescription="@string/keep_folder"
            android:elevation="20dp"
            android:translationZ="8dp"
            android:outlineProvider="background"
            android:outlineSpotShadowColor="#FF000000"
            android:outlineAmbientShadowColor="#BB000000"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_img_loading" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="默认收藏夹" />

        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            tools:text="0 个影片" />

    </LinearLayout>

    <ImageView
        android:id="@+id/delete"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/selector_image"
        android:contentDescription="@string/keep_folder_delete"
        android:src="@drawable/ic_action_delete"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>