<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:defaultFocusHighlightEnabled="false">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/black_20"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/Vod.Image"
            tools:layout_width="120dp"
            tools:layout_height="180dp"
            tools:src="@drawable/ic_img_loading" />

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_vod_name"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp"
            android:textColor="@color/white"
            android:textSize="13sp"
            tools:text="蜘蛛人：英雄归来" />

    </LinearLayout>

    <TextView
        android:id="@+id/year"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@id/container"
        android:layout_alignTop="@id/container"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/shape_vod_tag"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="2022"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/site"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignEnd="@id/container"
        android:layout_alignTop="@id/container"
        android:layout_marginEnd="6dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/shape_vod_tag"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="泥巴"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/remark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignStart="@id/container"
        android:layout_alignBottom="@id/container"
        android:layout_marginStart="6dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/shape_vod_tag"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="11sp"
        tools:text="更新至第10集" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/selector_vod"
        android:duplicateParentState="true" />

</RelativeLayout>
