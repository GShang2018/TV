<resources>

    <style name="AppTheme" parent="BaseTheme" />

    <style name="AppTheme.Live" parent="AppTheme">
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="AppTheme.Gallery" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <style name="BaseTheme" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Spotify 绿色主色调 -->
        <item name="colorPrimary">@color/spotify_green</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/spotify_green</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <!-- 次要色 -->
        <item name="colorSecondary">@color/white_70</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- SecondaryContainer：控制底部导航栏选中时的背景色（黑色20%透明度） -->
        <item name="colorSecondaryContainer">@color/black_20</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <!-- 表面/背景色 -->
        <item name="colorSurface">@color/spotify_surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/spotify_surface_elevated</item>
        <item name="colorOnSurfaceVariant">@color/white_70</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="colorSurfaceContainerLowest">@color/black</item>
        <item name="colorSurfaceContainerLow">@color/spotify_surface</item>
        <item name="colorSurfaceContainer">@color/spotify_surface</item>
        <item name="colorSurfaceContainerHigh">@color/spotify_surface_elevated</item>
        <item name="colorSurfaceContainerHighest">@color/spotify_surface_elevated</item>
        <item name="colorSurfaceBright">@color/spotify_surface_elevated</item>
        <item name="colorSurfaceDim">@color/black</item>
        <!-- 文本选中高亮色（跟随主题绿） -->
        <item name="android:textColorHighlight">@color/text_highlight</item>
        <!-- 禁用 elevation overlay，防止绿色滤镜叠加 -->
        <item name="elevationOverlayEnabled">false</item>
        <!-- 圆角设置：Dialog/底部弹出 16dp -->
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Leanback.Corner.ExtraLarge</item>
        <!-- 兼容旧属性 -->
        <item name="colorPrimaryDark">@color/spotify_green</item>
        <item name="colorAccent">@color/spotify_green</item>
        <!-- 窗口设置 -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="bottomSheetDialogTheme">@style/BottomSheetDialog</item>
    </style>

    <style name="ShapeAppearance.Leanback.Corner.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ModalBottomSheetDialog" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">#242424</item>
    </style>

    <style name="BottomSheetDialog" parent="Theme.Material3.Dark.BottomSheetDialog">
        <item name="colorPrimary">@color/spotify_green</item>
        <item name="colorPrimaryDark">@color/spotify_green</item>
        <item name="colorAccent">@color/spotify_green</item>
        <item name="colorSurface">#242424</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/ModalBottomSheetDialog</item>
    </style>

</resources>
