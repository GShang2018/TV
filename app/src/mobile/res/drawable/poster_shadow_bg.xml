<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底层阴影投影 -->
    <item
        android:left="3dp"
        android:top="4dp"
        android:right="5dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#40000000" />
        </shape>
    </item>
    <!-- 上层圆角填充 + 描边 -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#22111111" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
