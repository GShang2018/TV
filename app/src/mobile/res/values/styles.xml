<resources>

    <!-- ================================================================ -->
    <!-- 原有 AppTheme（向后兼容，深色绿色主题）                         -->
    <!-- ================================================================ -->

    <style name="AppTheme" parent="BaseTheme">
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <style name="AppTheme.Live" parent="AppTheme">
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="AppTheme.Detail" parent="AppTheme">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:windowTranslucentStatus">false</item>
    </style>

    <style name="AppTheme.Gallery" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <!-- ================================================================ -->
    <!-- 原有的深色基座主题                                               -->
    <!-- ================================================================ -->

    <style name="BaseTheme" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Spotify 绿色主色调 -->
        <item name="colorPrimary">@color/spotify_green</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/spotify_green</item>
        <item name="colorOnPrimaryContainer">@color/black</item>
        <!-- 次要色 -->
        <item name="colorSecondary">@color/white_70</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- SecondaryContainer：控制底部导航栏选中时的背景色（黑色20%透明度）和图标颜色 -->
        <item name="colorSecondaryContainer">@color/black_20</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <!-- 表面/背景色 -->
        <item name="colorSurface">@color/spotify_surface</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/spotify_surface_elevated</item>
        <item name="colorOnSurfaceVariant">@color/white_70</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="colorSurfaceContainerLowest">@color/black</item>
        <item name="colorSurfaceContainerLow">@color/spotify_surface</item>
        <item name="colorSurfaceContainer">@color/spotify_surface</item>
        <item name="colorSurfaceContainerHigh">@color/spotify_surface_elevated</item>
        <item name="colorSurfaceContainerHighest">@color/spotify_surface_elevated</item>
        <item name="colorSurfaceBright">@color/spotify_surface_elevated</item>
        <item name="colorSurfaceDim">@color/black</item>
        <!-- 禁用 elevation overlay，防止绿色滤镜叠加到有 elevation 的控件上 -->
        <item name="elevationOverlayEnabled">false</item>
        <!-- 文本选中高亮色（跟随主题绿） -->
        <item name="android:textColorHighlight">@color/text_highlight</item>
        <!-- 圆角设置：Dialog/底部弹出 16dp -->
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.Mobile.Corner.ExtraLarge</item>
        <!-- 兼容旧属性 -->
        <item name="colorPrimaryDark">@color/spotify_green</item>
        <item name="colorAccent">@color/spotify_green</item>
        <!-- 窗口设置 -->
        <item name="android:windowBackground">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:navigationBarColor">@color/transparent</item>
    </style>

    <!-- ================================================================ -->
    <!-- 可选择的主题色变体 — 深色                                         -->
    <!-- ================================================================ -->

    <style name="AppTheme.Green" parent="AppTheme" />

    <style name="AppTheme.Blue" parent="AppTheme">
        <item name="colorPrimary">@color/theme_blue</item>
        <item name="colorPrimaryContainer">@color/theme_blue</item>
        <item name="colorPrimaryDark">@color/theme_blue</item>
        <item name="colorAccent">@color/theme_blue</item>
        <item name="android:textColorHighlight">@color/text_highlight_blue</item>
    </style>

    <style name="AppTheme.Red" parent="AppTheme">
        <item name="colorPrimary">@color/theme_red</item>
        <item name="colorPrimaryContainer">@color/theme_red</item>
        <item name="colorPrimaryDark">@color/theme_red</item>
        <item name="colorAccent">@color/theme_red</item>
        <item name="android:textColorHighlight">@color/text_highlight_red</item>
    </style>

    <style name="AppTheme.Purple" parent="AppTheme">
        <item name="colorPrimary">@color/theme_purple</item>
        <item name="colorPrimaryContainer">@color/theme_purple</item>
        <item name="colorPrimaryDark">@color/theme_purple</item>
        <item name="colorAccent">@color/theme_purple</item>
        <item name="android:textColorHighlight">@color/text_highlight_purple</item>
    </style>

    <style name="AppTheme.Orange" parent="AppTheme">
        <item name="colorPrimary">@color/theme_orange</item>
        <item name="colorPrimaryContainer">@color/theme_orange</item>
        <item name="colorPrimaryDark">@color/theme_orange</item>
        <item name="colorAccent">@color/theme_orange</item>
        <item name="android:textColorHighlight">@color/text_highlight_orange</item>
    </style>

    <style name="AppTheme.Teal" parent="AppTheme">
        <item name="colorPrimary">@color/theme_teal</item>
        <item name="colorPrimaryContainer">@color/theme_teal</item>
        <item name="colorPrimaryDark">@color/theme_teal</item>
        <item name="colorAccent">@color/theme_teal</item>
        <item name="android:textColorHighlight">@color/text_highlight_teal</item>
    </style>

    <style name="AppTheme.Pink" parent="AppTheme">
        <item name="colorPrimary">@color/theme_pink</item>
        <item name="colorPrimaryContainer">@color/theme_pink</item>
        <item name="colorPrimaryDark">@color/theme_pink</item>
        <item name="colorAccent">@color/theme_pink</item>
        <item name="android:textColorHighlight">@color/text_highlight_pink</item>
    </style>

    <!-- ================================================================ -->
    <!-- 通用组件样式                                                      -->
    <!-- ================================================================ -->

    <style name="ShapeAppearance.Mobile.Corner.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Control" />

    <style name="Control.Action">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">8dp</item>
        <item name="android:shadowColor">@color/grey_200</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">0.5</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="shapeAppearance">@style/IndicatorShape</item>
    </style>

    <style name="IndicatorShape" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamilyTopLeft">rounded</item>
        <item name="cornerFamilyTopRight">rounded</item>
        <item name="cornerFamilyBottomLeft">rounded</item>
        <item name="cornerFamilyBottomRight">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

</resources>
